# Postgres (your own instance / Neon / Supabase). pg_trgm sẽ được tạo tự động.
DATABASE_URL=postgresql://user:password@host:5432/footwear

# ZAI (coding plan, OpenAI-compatible)
ZAI_API_KEY=your-zai-api-key
ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
